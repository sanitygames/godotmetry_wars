[layer_names]

2d_physics/layer_1="shot"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="enemyshot"
2d_physics/layer_9="wall"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

